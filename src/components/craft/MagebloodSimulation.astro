---
// MagebloodSimulation.astro — Divine Orb chase simulation for Mageblood
// User picks target legacies and % range, simulation runs until all targets hit
---
<div class="simulate-widget parchment p-6 mb-6" id="mb-sim-widget">
  <div class="flex items-center justify-between mb-4">
    <h3 class="!m-0 text-lg font-display">🎯 Mageblood Legacy Fishing</h3>
    <button id="mb-sim-run-btn" class="btn btn-danger text-sm px-4 py-1.5">
      ▶ Run Simulation
    </button>
  </div>

  <p class="text-xs text-dim mb-4">
    Chase until all 4 Legacy types AND the % effect range match your targets.
    Each Divine Orb independently rerolls all 5 values from the full pool.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
    <!-- Target legacies -->
    <div>
      <div class="text-xs text-dim mb-2 font-semibold">Target Legacies (pick 4)</div>
      <div class="grid grid-cols-2 gap-2">
        <select id="mb-legacy-1" class="bg-bg border border-border rounded px-2 py-1.5 text-xs w-full">
          <option value="">— Pick Legacy #1 —</option>
        </select>
        <select id="mb-legacy-2" class="bg-bg border border-border rounded px-2 py-1.5 text-xs w-full">
          <option value="">— Pick Legacy #2 —</option>
        </select>
        <select id="mb-legacy-3" class="bg-bg border border-border rounded px-2 py-1.5 text-xs w-full">
          <option value="">— Pick Legacy #3 —</option>
        </select>
        <select id="mb-legacy-4" class="bg-bg border border-border rounded px-2 py-1.5 text-xs w-full">
          <option value="">— Pick Legacy #4 —</option>
        </select>
      </div>
    </div>

    <!-- Target % range -->
    <div>
      <div class="text-xs text-dim mb-2 font-semibold">Target % Effect Range (25–50)</div>
      <div class="flex items-center gap-2 text-xs">
        <span class="text-dim">Min</span>
        <select id="mb-pct-min" class="bg-bg border border-border rounded px-2 py-1 flex-1">
          {Array.from({ length: 26 }, (_, i) => {
            const v = String(25 + i);
            return <option value={v} selected={i === 20}>{v}%</option>;
          })}
        </select>
        <span class="text-dim">Max</span>
        <select id="mb-pct-max" class="bg-bg border border-border rounded px-2 py-1 flex-1">
          {Array.from({ length: 26 }, (_, i) => {
            const v = String(25 + i);
            return <option value={v} selected={i === 25}>{v}%</option>;
          })}
        </select>
      </div>
    </div>
  </div>

  <div class="flex gap-3 mb-3">
    <span class="text-xs text-dim">Divine Orb: ~1.0 div each</span>
  </div>

  <div id="mb-results" class="hidden">
    <div class="grid grid-cols-3 gap-3 mb-3">
      <div class="parchment p-3 text-center">
        <div class="text-xs text-dim">Divines Used</div>
        <div class="text-xl font-bold text-gold" id="mb-divines">-</div>
      </div>
      <div class="parchment p-3 text-center">
        <div class="text-xs text-dim">Total Cost</div>
        <div class="text-xl font-bold text-corrupted" id="mb-cost">-</div>
      </div>
      <div class="parchment p-3 text-center">
        <div class="text-xs text-dim">Odds Per Divine</div>
        <div class="text-lg font-mono text-gold" id="mb-odds">-</div>
      </div>
    </div>
    <div class="parchment p-3 mb-3">
      <div id="mb-hit-details" class="text-xs text-dim font-mono"></div>
    </div>
    <div id="mb-log" class="text-xs text-dim font-mono max-h-32 overflow-y-auto mb-3"></div>
    <div class="text-center">
      <button id="mb-replay-btn" class="btn btn-danger text-sm px-4 py-1.5 hidden">
        ▶ Run Again
      </button>
    </div>
  </div>
</div>

<script>
  const LEGACY_POOL = [
    'Legacy of Diamond', 'Legacy of Gold', 'Legacy of Jade',
    'Legacy of Quicksilver', 'Legacy of Ruby', 'Legacy of Sapphire',
    'Legacy of Silver', 'Legacy of Stibnite', 'Legacy of Sulphur',
    'Legacy of Topaz', 'Legacy of Amethyst',
  ];
  const DIVINE_COST = 1.0;

  // Populate dropdowns
  function fillSelect(el: HTMLSelectElement) {
    LEGACY_POOL.forEach(l => {
      const opt = document.createElement('option');
      opt.value = l;
      opt.textContent = l;
      el.appendChild(opt);
    });
  }

  fillSelect(document.getElementById('mb-legacy-1') as HTMLSelectElement);
  fillSelect(document.getElementById('mb-legacy-2') as HTMLSelectElement);
  fillSelect(document.getElementById('mb-legacy-3') as HTMLSelectElement);
  fillSelect(document.getElementById('mb-legacy-4') as HTMLSelectElement);

  const runBtn = document.getElementById('mb-sim-run-btn') as HTMLButtonElement;
  const replayBtn = document.getElementById('mb-replay-btn') as HTMLButtonElement;
  const resultsEl = document.getElementById('mb-results')!;
  const divinesEl = document.getElementById('mb-divines')!;
  const costEl = document.getElementById('mb-cost')!;
  const oddsEl = document.getElementById('mb-odds')!;
  const hitDetailsEl = document.getElementById('mb-hit-details')!;
  const logEl = document.getElementById('mb-log')!;

  const sel1 = document.getElementById('mb-legacy-1') as HTMLSelectElement;
  const sel2 = document.getElementById('mb-legacy-2') as HTMLSelectElement;
  const sel3 = document.getElementById('mb-legacy-3') as HTMLSelectElement;
  const sel4 = document.getElementById('mb-legacy-4') as HTMLSelectElement;
  const pctMin = document.getElementById('mb-pct-min') as HTMLSelectElement;
  const pctMax = document.getElementById('mb-pct-max') as HTMLSelectElement;

  let running = false;
  let aborted = false;

  function randomLegacy(): string {
    return LEGACY_POOL[Math.floor(Math.random() * LEGACY_POOL.length)];
  }

  function randomPct(): number {
    return 25 + Math.floor(Math.random() * 26);
  }

  function canReroll(legs: string[], pct: number): boolean {
    const targets = [sel1.value, sel2.value, sel3.value, sel4.value];
    const minP = parseInt(pctMin.value);
    const maxP = parseInt(pctMax.value);
    
    // Check all 4 legacies are targets
    const matchLegs = targets.every(t => t === '' || legs.includes(t)) && 
      legs.every((l, i) => l === targets[i]);
    const matchPct = pct >= minP && pct <= maxP;
    return !matchLegs || !matchPct;
  }

  async function runChase() {
    const targets = [sel1.value, sel2.value, sel3.value, sel4.value];
    if (targets.some(t => t === '')) {
      logEl.innerHTML = '<div class="text-corrupted">⚠️ Please pick all 4 target legacies.</div>';
      resultsEl.classList.remove('hidden');
      return;
    }

    running = true;
    aborted = false;
    runBtn.textContent = '⏳ Chasing...';
    runBtn.disabled = true;
    replayBtn.classList.add('hidden');
    resultsEl.classList.remove('hidden');

    const poolSize = LEGACY_POOL.length;
    const pctRange = parseInt(pctMax.value) - parseInt(pctMin.value) + 1;

    // Odds per divine: (1/poolSize)^4 for legacies × (range/26) for %
    const legacyOdds = Math.pow(1 / poolSize, 4);
    const pctOdds = pctRange / 26;
    const combinedOdds = legacyOdds * pctOdds;
    const oneIn = Math.round(1 / combinedOdds);
    oddsEl.textContent = '1 in ' + oneIn.toLocaleString();

    let divineCount = 0;
    const currentLegacies: string[] = [randomLegacy(), randomLegacy(), randomLegacy(), randomLegacy()];
    let currentPct = randomPct();
    
    const start = performance.now();
    const updateInterval = divineCount + 5000;

    while (canReroll(currentLegacies, currentPct)) {
      if (aborted) {
        logEl.innerHTML += '<div class="text-corrupted">⏹️ Aborted.</div>';
        running = false;
        runBtn.textContent = '▶ Run Simulation';
        runBtn.disabled = false;
        replayBtn.classList.remove('hidden');
        return;
      }

      // Reroll all 4 legacies independently + the %
      for (let i = 0; i < 4; i++) {
        currentLegacies[i] = randomLegacy();
      }
      currentPct = randomPct();
      divineCount++;

      // Update display every N divines
      if (divineCount % 5000 === 0) {
        const elapsed = ((performance.now() - start) / 1000).toFixed(1);
        logEl.innerHTML = '<div>🔄 ' + divineCount.toLocaleString() + ' divines used so far (' + elapsed + 's)...</div>';
        divinesEl.textContent = divineCount.toLocaleString();
        costEl.textContent = (divineCount * DIVINE_COST).toLocaleString(undefined, { maximumFractionDigits: 0 }) + ' div';
        await new Promise(r => setTimeout(r, 0));
      }
    }

    const elapsed = ((performance.now() - start) / 1000).toFixed(1);

    divinesEl.textContent = divineCount.toLocaleString();
    costEl.textContent = (divineCount * DIVINE_COST).toLocaleString(undefined, { maximumFractionDigits: 0 }) + ' div';

    hitDetailsEl.innerHTML = 
      '<div class="text-gold font-semibold mb-2">🎯 HIT! All targets matched after ' + divineCount.toLocaleString() + ' Divine Orbs</div>' +
      '<div>Legacy #1: <span class="text-gold">' + currentLegacies[0] + '</span></div>' +
      '<div>Legacy #2: <span class="text-gold">' + currentLegacies[1] + '</span></div>' +
      '<div>Legacy #3: <span class="text-gold">' + currentLegacies[2] + '</span></div>' +
      '<div>Legacy #4: <span class="text-gold">' + currentLegacies[3] + '</span></div>' +
      '<div>% Effect: <span class="text-gold">' + currentPct + '%</span> (target: ' + pctMin.value + '–' + pctMax.value + '%)</div>';

    logEl.innerHTML += '<div class="text-gold mt-1">✅ Hit after ' + divineCount.toLocaleString() + ' divines (' + elapsed + 's) — ~' + costEl.textContent + '</div>';

    runBtn.textContent = '▶ Run Simulation';
    runBtn.disabled = false;
    replayBtn.classList.remove('hidden');
    running = false;
  }

  runBtn.addEventListener('click', () => {
    if (running) { aborted = true; return; }
    runChase();
  });

  replayBtn.addEventListener('click', () => {
    logEl.innerHTML = '';
    hitDetailsEl.innerHTML = '';
    runChase();
  });
</script>
