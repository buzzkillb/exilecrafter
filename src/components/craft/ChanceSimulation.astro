---
// ChanceSimulation.astro — single-run Orb of Chance simulation
// Simulates chancing a white belt until the target unique hits.
// Shows: orbs used, POOFs, trash uniques created.
---

<div class="simulate-widget parchment p-6 mb-6" id="chance-sim-widget">
  <div class="flex items-center justify-between mb-4">
    <h3 class="!m-0 text-lg font-display">White Belt Orb of Chance Fishing</h3>
    <button id="chance-sim-run-btn" class="btn btn-danger text-sm px-4 py-1.5">
      ▶ Run Simulation
    </button>
  </div>

  <p class="text-xs text-dim mb-4">
    Simulates using Orb of Chance on a Normal white belt until the target unique drops.
    Each Orb of Chance: ~1% chance to upgrade to a random unique, ~99% chance to destroy (POOF).
    This simulation keeps chancing until the target unique hits — counting every POOF and
    trash unique along the way.
  </p>

  <div class="mb-4">
    <div class="text-xs text-dim mb-2 font-semibold">Belt Base</div>
    <select id="chance-base" class="bg-bg border border-border rounded px-2 py-1.5 text-xs w-full max-w-xs">
      <option value="heavy_belt" selected>Heavy Belt → Headhunter</option>
      <option value="utility_belt">Utility Belt → Mageblood</option>
    </select>
    <span class="text-xs text-dim ml-2">Orb of Chance: ~0.01 div each</span>
  </div>

  <div id="chance-results" class="hidden">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-3">
      <div class="parchment p-3 text-center">
        <div class="text-xs text-dim">Orbs of Chance Used</div>
        <div class="text-2xl font-bold text-gold" id="chance-orbs">-</div>
      </div>
      <div class="parchment p-3 text-center">
        <div class="text-xs text-dim">POOF (Destroyed)</div>
        <div class="text-2xl font-bold text-red-400" id="chance-poofs">-</div>
      </div>
      <div class="parchment p-3 text-center">
        <div class="text-xs text-dim">Trash Uniques Created</div>
        <div class="text-2xl font-bold text-yellow-400" id="chance-trash">-</div>
      </div>
      <div class="parchment p-3 text-center">
        <div class="text-xs text-dim">Total Cost</div>
        <div class="text-2xl font-bold text-gold" id="chance-cost">-</div>
      </div>
    </div>
    <div class="parchment p-3 text-sm text-center text-gold font-semibold" id="chance-target-line"></div>
    <div class="parchment p-3 text-xs font-mono text-dim min-h-[48px] whitespace-pre-wrap" id="chance-log"></div>
    <div class="text-xs text-dim mt-2">Click <b>▶ Run Simulation</b> again for another attempt.</div>
  </div>
</div>

<script>
  (function() {
    var BASE = document.getElementById('chance-base');
    var RUN = document.getElementById('chance-sim-run-btn');
    var RESULTS = document.getElementById('chance-results');

    // Unique pools + target (must match src/lib/orb-of-chance-pools.ts)
    var POOLS = {
      heavy_belt: { pool: ['Waistgate', 'Headhunter', "Zerphi's Genesis"], target: 'Headhunter' },
      utility_belt: { pool: ["Cat O' Nine Tails", 'Ingenuity', 'Mageblood'], target: 'Mageblood' },
    };

    var ORB_PRICE = 0.01; // div per Orb of Chance

    var running = false;
    RUN.addEventListener('click', function() {
      if (running) return;
      var poolEntry = POOLS[BASE.value];
      var pool = poolEntry.pool;
      var targetName = poolEntry.target;

      running = true;
      RUN.textContent = '⏳ Simulating...';
      RUN.disabled = true;
      RESULTS.classList.remove('hidden');

      var logEl = document.getElementById('chance-log');
      logEl.innerHTML = 'Chancing ' + (BASE.value === 'heavy_belt' ? 'Heavy Belt' : 'Utility Belt') + ' until ' + targetName + ' hits...';

      var orbs = 0;
      var poofs = 0;
      var trash = 0;
      var hit = false;

      function runBatch() {
        var batchMax = 500;
        var batch = 0;
        while (batch < batchMax && !hit) {
          batch++;
          orbs++;
          var roll = Math.random();
          if (roll < 0.01) {
            // Hit unique
            var idx = Math.floor(Math.random() * pool.length);
            if (pool[idx] === targetName) {
              hit = true;
            } else {
              trash++;
            }
          } else {
            poofs++;
          }
        }

        if (!hit) {
          logEl.innerHTML = 'Still chancing... ' + orbs.toLocaleString() + ' orbs used so far...';
          setTimeout(runBatch, 0);
        } else {
          finish();
        }
      }

      function finish() {
        var cost = (orbs * ORB_PRICE).toFixed(1);

        document.getElementById('chance-orbs').textContent = orbs.toLocaleString();
        document.getElementById('chance-poofs').textContent = poofs.toLocaleString();
        document.getElementById('chance-trash').textContent = trash.toLocaleString();
        document.getElementById('chance-cost').textContent = cost + ' div';
        document.getElementById('chance-target-line').textContent = '🎯 Hit ' + targetName + '!';

        logEl.innerHTML = '✅ Found ' + targetName + ' after ' + orbs.toLocaleString() + ' orbs' +
          '\n   POOF: ' + poofs.toLocaleString() + '  Trash: ' + trash.toLocaleString() +
          '  Cost: ~' + cost + ' div';

        running = false;
        RUN.textContent = '▶ Run Simulation';
        RUN.disabled = false;
      }

      runBatch();
    });
  })();
</script>
